{
  "name": "@nevent/widget",
  "version": "1.0.0-alpha.0",
  "description": "Nevent embeddable support chat (loader + iframe shell)",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "vite build && vite build --config vite.loader.config.ts && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0",
    "@preact/preset-vite": "^2.9.0"
  },
  "publishConfig": { "access": "public" }
}
